# ===== 评估方式 =====
# local（默认）：本地规则生成影响/建议，不调用 OpenAI
# openai：使用下方 OPENAI_* 调兼容接口
# cursor：配合 Cursor Automations 两阶段（--dump-pending / --push-report）
AI_PROVIDER=local

# ===== AI 评估 (仅 AI_PROVIDER=openai 时需要) =====
# 兼容 OpenAI / DeepSeek / 通义千问 / 自建网关 等
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ===== 飞书 Lark 机器人 =====
# 在群里添加自定义机器人后获取 Webhook
# 国际版 Lark： https://open.larksuite.com/open-apis/bot/v2/hook/xxxx
# 中国版飞书： https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
LARK_WEBHOOK_URL=https://open.larksuite.com/open-apis/bot/v2/hook/xxxxxxxxxxxx
# 可选：开启加签（在机器人安全设置里启用），未启用留空即可
LARK_SECRET=

# ===== 抓取范围控制 =====
# 抓取最近 N 天内的更新（避免首次跑刷屏）
LOOKBACK_DAYS=7
# 单平台单条消息最多列出几条
MAX_ITEMS_PER_PLATFORM=10

# ===== 业务上下文（让评估更贴合你的 App） =====
# 可写：App 名称 / 当前主要技术栈 / 核心功能 / 目前的痛点等
APP_CONTEXT=我们的 App 是一款金融移动应用，iOS 使用 Objective-C，Android 使用 Java。核心功能：行情、下单、资产、消息推送、生物识别登录。
